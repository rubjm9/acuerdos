# ============================================================================
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
#
# MVP (Vercel + Supabase): ver docs/mvp-vercel-supabase.md
# Stack completo (Docker): usar este fichero en la raíz + docker compose
# ============================================================================

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=acuerdos
POSTGRES_USER=acuerdos_owner
POSTGRES_PASSWORD=cambia-esta-contraseña
# Contraseñas de los roles de aplicación (menos privilegio, sujetos a RLS)
APP_WEB_DB_PASSWORD=cambia-esta-contraseña
APP_WORKER_DB_PASSWORD=cambia-esta-contraseña

# --- MinIO / S3 (almacenamiento de objetos) -----------------------------------
# Docker local: MinIO. MVP: Supabase Storage (API S3).
MINIO_ROOT_USER=acuerdos_minio
MINIO_ROOT_PASSWORD=cambia-esta-contraseña
# En web/.env.local o Vercel también:
# S3_ENDPOINT=...
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET_ACTAS=actas
# S3_BUCKET_EXPORTS=exports

# --- Autenticación -------------------------------------------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# OAuth de Google Workspace (OIDC). El login queda restringido a este dominio.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_DOMAIN=bahai.es
# SOLO desarrollo / MVP inicial: login por email sin contraseña (true/false)
AUTH_DEV_LOGIN=false

# --- Cifrado a nivel de campo (áreas restringidas) ------------------------------
# Clave AES-256 en base64. Genera con: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- IA autoalojada (SOLO endpoints propios; jamás un proveedor externo) --------
# En el nodo GPU: http://vllm:8000/v1 , http://tei-embed:80 , http://tei-rerank:80
# En el MVP déjalos vacíos.
LLM_BASE_URL=
LLM_MODEL=mistral-small-3
TEI_EMBED_URL=
TEI_RERANK_URL=
EMBEDDING_DIM=1024

# --- Correo (SMTP en la UE) -----------------------------------------------------
# Formato: smtps://usuario:contraseña@smtp.proveedor.eu:465
SMTP_URL=
SMTP_FROM=plataforma@bahai.es

# --- Web Push (VAPID) ------------------------------------------------------------
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Puertos locales ---------------------------------------------------------------
WEB_PORT=3000
WORKER_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
